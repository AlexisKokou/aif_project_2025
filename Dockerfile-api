# Use an official Python runtime as the parent image
FROM python:3.10-slim

# Set the working directory in the container to /app
WORKDIR /app

# Install system dependencies for image processing
RUN apt-get update && apt-get install -y \
    libgl1-mesa-dev \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first (for better caching)
COPY requirements-api.txt .

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements-api.txt

# Copy the current directory contents into the container at /app
COPY . /app

# Create directories for models and weights
RUN mkdir -p models weights

# Make port 5075 available (matching your API port)
EXPOSE 5075

# Define environment variable for Flask
ENV FLASK_ENV=production
ENV PYTHONUNBUFFERED=1

# Run movie_api.py when the container launches
CMD ["python", "movie_api.py", "--model_path", "weights/movie_poster_net.pth"]